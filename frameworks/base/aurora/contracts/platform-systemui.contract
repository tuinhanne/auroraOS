# aurora.platform.systemui - an assembly unit, and after Sprint 10 that is ALL it is.
#
# ADR-014 created this layer because of process: it runs inside SystemUI while
# aurora-platform-android runs inside system_server. That is still why the layer exists. What changed
# in Sprint 10 is that the layer stopped being a place code lives.
#
# It now owns exactly three facts, all of them properties of a deployed artifact rather than of any
# behaviour:
#
#   - the APK's package name, which MUST equal Aurora's entry in config_pluginAllowlist
#     (PluginInstance.kt:301 calls isPackagePrivileged(pluginAppInfo.packageName))
#   - the <uses-permission> for com.android.systemui.permission.PLUGIN
#   - the <service> that makes a feature findable, naming a class in a feature's package
#
# Features are android_library modules with their own contracts - see feature-volume.contract. This
# is the artifact they ship in, and one artifact can ship several.

layer:          platform-systemui
module:         AuroraSystemUIPlugin
package-root:   aurora.platform.systemui
source-root:    platform/systemui/java

# THE DECLARATION THAT MATTERS, and it was added because the alternatives both lied.
#
# When Sprint 10 emptied this module, arch-test.sh had two ways to handle it and both were wrong:
#
#   source-root points at a deleted directory  ->  "skip: layer not created yet"
#                                                  False. The layer exists and is finished.
#   source-root omitted                        ->  every forbid-import reports ok
#                                                  Vacuously green. A contract that checks nothing
#                                                  while claiming to check everything.
#
# The second is the dangerous one, and it was not specific to this module: ANY contract with a
# typo'd source-root was passing that way. So the gate grew a third answer, and the check for it is
# the point of this line rather than a formality - it asserts the absence, instead of tolerating it.
expect-no-source: yes

# Deps still matter, and they are the only thing left to enforce here. The APK may link features and
# the plugin API, and nothing else.
allow-dep:      AuroraVolumeFeature
allow-dep:      SystemUIPluginLib

# The process boundary, as a build fact. A dependency edge here would be a link the runtime cannot
# honour, and an APK that accepted it would die at load.
forbid-dep:     aurora-platform-android
forbid-dep:     aurora-device

expect-classpath: platform_apis
expect-host-supported: no
