# aurora.platform - system integration, and still no Android in it.
#
# This file used to say that this layer would be "the only layer allowed to reach into android.*
# (from Sprint 03)". Sprint 03 did the opposite: ADR-012 put the Android surface in a fourth layer,
# `aurora.platform.android`, and left this one exactly as it was.
#
# The reason is Soong rather than taste. `sdk_version` and `platform_apis` are module-global, so
# there is no way to say "core_current on the host, platform on the device" in one module - and
# this module is `host_supported` and is what `aurora-platform-tests` statically links. Admitting
# Android here would have taken the host test graph with it.

layer:          platform
module:         aurora-platform
package-root:   aurora.platform
source-root:    platform/java

allow-aurora-import: aurora.sdk.
allow-aurora-import: aurora.runtime.

# The `android.` line below stays. It was scheduled for deletion by Sprint 03 and outlived the
# plan: the narrow allow list it was going to be replaced by now lives in
# platform-android.contract, which is the only contract in this directory that permits an Android
# import. com.android.internal. stays forbidden everywhere and permanently: it is unstable private
# API, and depending on it makes every AOSP rebase a liability.
forbid-import:  android.
forbid-import:  com.android.internal.
forbid-import:  aurora.device.

allow-dep:      aurora-runtime

forbid-dep:     aurora-device

# The system server, as a family rather than as one name.
#
# This read `forbid-dep: services` until Sprint 03 Task 3, which found the line was doing exactly
# what it said and nothing more: the checkout holds 89 Soong modules called `services` or
# `services.something`, and only the bare one was named. `services.core` - where
# `com.android.server.SystemService` lives - was never forbidden, so this layer could have taken a
# dependency on the system server internals with no gate saying a word.
#
# Not a defect in the gate. A contract that named one member of a family, in a file whose
# convention is to name modules.
forbid-dep-family: services

# RULE-007 does not restrict the platform: this is the layer whose job is to know
# what Android actually is. Sprint 08 (Android Platform Bridge) adds
# ChoreographerFrameScheduler and friends here.
