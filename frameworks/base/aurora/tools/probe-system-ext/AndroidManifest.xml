<?xml version="1.0" encoding="utf-8"?>
<!--
     An instrument for Sprint 09 Task 3.1. Delete after the measurement.

     android:priority is set to 1 on purpose, matching the product RRO that currently wins. If the
     runtime honoured this number the probe would tie rather than win, and the measurement would be
     ambiguous. Task 3.0b measured that the runtime discards it and derives mPriority from the
     partition - so setting it to a value that would NOT help is how this file avoids quietly
     re-testing an already-refuted mechanism. If the probe wins, the partition is why.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="aurora.probe.partition">

    <application android:hasCode="false" />

    <overlay
        android:targetPackage="com.android.systemui"
        android:isStatic="true"
        android:priority="1" />

</manifest>
