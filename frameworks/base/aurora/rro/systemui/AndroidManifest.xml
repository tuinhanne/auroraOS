<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="aurora.rro.systemui">

    <application android:hasCode="false" />

    <!--
         android:priority is present because the schema wants it and is NOT what makes this
         overlay win. Task 3.0b measured that OverlayManager discards the manifest value and
         derives mPriority from the partition: the auto-generated product RRO declares 1 and
         receives 32, the vendor one declares 0 and receives 4. Task 3.1 then measured that an
         overlay in system_ext receives 39 while declaring 1.

         So the number below is documentation, not mechanism. Changing it changes nothing.
         Moving this module out of system_ext would change everything.
    -->
    <overlay
        android:targetPackage="com.android.systemui"
        android:isStatic="true"
        android:priority="1" />

</manifest>
