<!--
     This file is the array that wins. There is exactly one other place in this repository that
     declares what it should contain - contracts/artifact/systemui-plugin-allowlist.contract - and
     that file is the authority. This one is what the build turns into an artifact.

     Keeping them separate is the whole of ADR-015: the gate reads the contract and checks this
     file's output, and neither owns the truth alone. Editing this file without editing the
     contract makes the gate red, which is the intended behaviour and not an inconvenience.
-->
<resources>

    <!--
         SystemUI plugins loadable when Build.IS_DEBUGGABLE is false.

         PluginActionManager.kt:222 / PluginInstance.kt:301:
             if (!buildInfo.isDebuggable && !config.isPrivileged(component)) { ... }

         And ro.debuggable IS 0 on this project's builds - vendor/lineage/config/common.mk:42 sets
         it deliberately for userdebug, and Build.java:1851 reads that property and nothing else.
         So this gate fires on the emulator on the desk, not only on some future user build.

         "privileged" here has nothing to do with priv-app or PRIVATE_FLAG_PRIVILEGED. It is only
         membership in this array, read once by PluginsModule.java:99.

         An overlay REPLACES an array rather than merging into it, so the first three entries are
         not decoration - they are the part of this contract Aurora does not own and is answerable
         for anyway. Dropping one would disable another project's plugin, silently. ADR-015.
    -->
    <string-array name="config_pluginAllowlist" translatable="false">
        <!-- AOSP. frameworks/base/packages/SystemUI/res/values/config.xml -->
        <item>com.android.systemui</item>
        <!-- Lineage. vendor/lineage/overlay/common/.../SystemUI/res/values/config.xml -->
        <item>com.android.systemui.plugin.globalactions.wallet</item>
        <item>org.lineageos.settings.device</item>
        <!-- Aurora. ADR-014's plugin APK, and the only line this module exists to add. -->
        <item>aurora.platform.systemui</item>
    </string-array>

</resources>
