<!--
     A library manifest, and it exists for one reason: to name the package the R class lands in.

     It declares NO service and NO permission. Those belong to the APK, because being loadable as a
     SystemUI plugin is a property of the deployed artifact rather than of this code - the same
     library linked into a differently-named APK would need a different allowlist entry and a
     different <service>. Keeping the declaration at the app layer is what lets the feature stay
     independent of how it ships.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="aurora.feature.volume" />
