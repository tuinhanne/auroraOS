package {
    default_applicable_licenses: ["frameworks_base_license"],
}

// ---------------------------------------------------------------------------
// Layer 1: aurora.sdk
//
// Public, stable surface. Pure Java, no dependency on anything else in the
// tree. Everything above may depend on this; it depends on nothing.
// ---------------------------------------------------------------------------
java_library {
    name: "aurora-sdk",
    srcs: [
        "sdk/java/**/*.java",
        "sdk/java/**/*.kt",
    ],
    sdk_version: "core_current",
    host_supported: true,
    installable: false,
    // Soong cannot express "runtime must not depend on platform", but it can say
    // who may depend on a module at all. This keeps the layers from being reached
    // into from elsewhere in the tree. Sprint 03 will widen aurora-platform only,
    // when a product needs to install it; sdk and runtime stay restricted.
    visibility: ["//frameworks/base/aurora:__subpackages__"],
}

// ---------------------------------------------------------------------------
// Layer 2: aurora.runtime
//
// Process lifecycle and environment abstraction. Depends on the SDK only.
// ---------------------------------------------------------------------------
java_library {
    name: "aurora-runtime",
    srcs: [
        "runtime/java/**/*.java",
        "runtime/java/**/*.kt",
    ],
    static_libs: ["aurora-sdk"],
    sdk_version: "core_current",
    host_supported: true,
    installable: false,
    visibility: ["//frameworks/base/aurora:__subpackages__"],
}

// ---------------------------------------------------------------------------
// Layer 3: aurora.platform
//
// System integration layer. This is the only layer that will be allowed to
// reach into android.* once Sprint 03 wires Aurora into the platform.
// ---------------------------------------------------------------------------
java_library {
    name: "aurora-platform",
    srcs: [
        "platform/java/**/*.java",
        "platform/java/**/*.kt",
    ],
    static_libs: ["aurora-runtime"],
    sdk_version: "core_current",
    host_supported: true,
    installable: false,
    visibility: ["//frameworks/base/aurora:__subpackages__"],
}

// ---------------------------------------------------------------------------
// Layer 4: aurora.platform.android
//
// The only module in the tree that may see Android. ADR-012.
//
// Split from aurora-platform rather than folded into it, because Soong's
// sdk_version and platform_apis are module-global: there is no spelling of
// "core_current on the host, platform on the device" in one module. Measuring
// that is what closed the question - see the ADR - and the consequence is that
// the layer boundary and the module boundary are now the same line. Everything
// below stays host-testable because Android is *absent from its classpath*,
// not merely unused by it.
//
// Device-only on purpose. host_supported would create a variant that can never
// resolve `android.`, which is how the first measurement failed.
// ---------------------------------------------------------------------------
java_library {
    name: "aurora-platform-android",
    srcs: [
        "platform/android/java/**/*.java",
        "platform/android/java/**/*.kt",
    ],
    static_libs: ["aurora-platform"],
    libs: ["services.core"],
    platform_apis: true,
    installable: true,
    visibility: ["//frameworks/base/aurora:__subpackages__"],
}

// ---------------------------------------------------------------------------
// Unit tests: run on the host, no device or emulator required.
//   m aurora-platform-tests && out/host/linux-x86/nativetest*/... (or atest)
// ---------------------------------------------------------------------------
java_test_host {
    name: "aurora-platform-tests",
    srcs: [
        "tests/java/**/*.java",
        "tests/java/**/*.kt",
    ],
    static_libs: [
        "aurora-platform",
        "junit",
    ],
    test_options: {
        unit_test: true,
    },
}
