// The APK Aurora's SystemUI features ship in. ADR-014 for why it is a separate layer from
// aurora-platform-android; Sprint 10 for why it now contains no code of its own.
//
// This module is an ASSEMBLY UNIT. It owns the manifest - the plugin permission, the <service> that
// makes the feature findable, and the package name that must match Aurora's entry in
// config_pluginAllowlist - and nothing else. Features are android_library modules statically linked
// in, each with its own contract.
//
// The separation is the point: `aurora.platform.systemui` is the name of a deployed artifact, and
// `aurora.feature.volume` is the name of a body of code. Sprint 09 had them as one thing because
// there was one feature.

android_app {
    name: "AuroraSystemUIPlugin",

    manifest: "AndroidManifest.xml",

    // No srcs. Every line of behaviour arrives through here.
    static_libs: [
        "AuroraVolumeFeature",
    ],

    libs: ["SystemUIPluginLib"],

    // SystemUI declares com.android.systemui.permission.PLUGIN as protectionLevel="signature", so
    // this is not a preference. Sprint 09 Task 2 measured it.
    certificate: "platform",

    platform_apis: true,

    // Same partition as every other Aurora artifact, and the same reason as ADR-013's build
    // failure: system/ is inside generic_system.mk's artifact path requirement.
    system_ext_specific: true,

    optimize: {
        enabled: false,
    },
}
