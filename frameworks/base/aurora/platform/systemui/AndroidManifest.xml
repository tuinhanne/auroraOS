<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="aurora.platform.systemui">

    <!--
         This package name is load-bearing twice over.

         PluginInstance.kt:301 calls config.isPackagePrivileged(pluginAppInfo.packageName), so it
         must match an entry in config_pluginAllowlist exactly - and the entry Aurora ships in
         AuroraSystemUIOverlay is the string "aurora.platform.systemui". Renaming this package
         without renaming that entry produces a plugin that never loads and logs nothing.

         It is also the layer's package-root, so arch-test.sh watches the source under it.
    -->

    <!--
         protectionLevel="signature" in SystemUI's manifest. Granted because this APK is signed with
         the platform key, which is why Android.bp says certificate: "platform".
    -->
    <uses-permission android:name="com.android.systemui.permission.PLUGIN" />

    <application android:label="Aurora">

        <!--
             Declared as a <service> although AuroraVolumeDialog is not a Service. That is how the
             plugin framework works: PluginActionManager queries intent services for the action, then
             loads the named class through the plugin's own ClassLoader and casts it to the plugin
             interface. ExamplePlugin does the same with a class implementing OverlayPlugin.

             exported="true" is REQUIRED and was measured, not chosen. PluginActionManager.kt:192 is
             `packageManager.queryIntentServices(intent, 0)` - flags 0, so a non-exported service in
             another package is never returned. The first build shipped exported="false", copied from
             ExamplePlugin, and SystemUI logged:

                 PluginActionManager[com.android.systemui.action.PLUGIN_VOLUME]: Found 0 plugins

             ExamplePlugin is from 2015 and nothing loads it. SystemUI's clocks/sample plugin, added
             in 2025 and actually shipped, uses exported="true" and directBootAware="true". Looking
             at the thing that works beat looking at the thing named "Example".

             directBootAware because volume keys work before the first unlock, so SystemUI queries
             for this plugin while the user is still locked out.
        -->
        <!--
             Fully qualified, and now in a DIFFERENT package from this manifest's own. That is the
             Sprint 10 split visible in one line: the APK is aurora.platform.systemui because the
             allowlist entry says so, and the class is aurora.feature.volume.AuroraVolumeDialog
             because that is where volume's code lives. A relative ".AuroraVolumeDialog" would have
             silently resolved against the APK's package and pointed at nothing.
        -->
        <service
            android:name="aurora.feature.volume.AuroraVolumeDialog"
            android:label="Aurora volume"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <!-- VolumeDialog.ACTION. Not spelled out anywhere but here and the interface. -->
                <action android:name="com.android.systemui.action.PLUGIN_VOLUME" />
            </intent-filter>
        </service>

    </application>

</manifest>
